# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon / Supabase free tier recommended)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Pipeline Behaviour ────────────────────────────────────────────────────────
# Number of cycles per engine unit ingested per synthetic "batch day"
BATCH_SIZE=50

# Number of rows per DB write chunk during the load phase
CHUNK_SIZE=10000

# Absolute path to the directory containing NASA .txt source files
DATA_PATH=./data

# Which C-MAPSS dataset to process (FD001 | FD002 | FD003 | FD004)
DATASET=FD001

# ── Data Quality ──────────────────────────────────────────────────────────────
# Maximum hours since last successful batch before freshness check fails
FRESHNESS_SLA_HOURS=26

# Maximum null rate (0–1) allowed per column before validation fails
NULL_RATE_THRESHOLD=0.05

# Maximum fraction of out-of-range sensor readings before validation fails
OUT_OF_RANGE_THRESHOLD=0.02
